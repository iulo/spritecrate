{
  "name": "@spritetuck/core",
  "version": "0.1.3",
  "description": "SpriteTuck core: deterministic texture atlas tooling",
  "keywords": [
    "cocos-creator",
    "cocos2d",
    "phaser",
    "phaser4",
    "pixijs",
    "spritesheet",
    "spritetuck",
    "texture-atlas",
    "texture-packer"
  ],
  "homepage": "https://github.com/iulo/spritetuck#readme",
  "bugs": {
    "url": "https://github.com/iulo/spritetuck/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iulo/spritetuck.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "node ../../scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
