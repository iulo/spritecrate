{
  "name": "spritecrate-workspace",
  "version": "0.1.4",
  "private": true,
  "homepage": "https://github.com/iulo/spritecrate#readme",
  "bugs": {
    "url": "https://github.com/iulo/spritecrate/issues"
  },
  "author": {
    "name": "iulo",
    "url": "https://github.com/iulo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iulo/spritecrate.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "oxlint packages tests scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:package": "pnpm -r check:package",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:package && pnpm check:consumer",
    "benchmark": "node benchmarks/run.mjs",
    "version:packages": "lerna version --no-push",
    "release": "lerna publish from-package",
    "check:phaser": "node scripts/check-phaser.mjs",
    "cli": "node packages/cli/dist/index.js",
    "example": "node examples/node-basic.mjs",
    "check:registry": "node scripts/check-consumer.mjs --registry",
    "check:pixi": "node scripts/check-pixi.mjs",
    "check:engines": "pnpm check:phaser && pnpm check:pixi"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.65.1",
    "@spritecrate/core": "workspace:*",
    "@spritecrate/node": "workspace:*",
    "@types/node": "26.6.6",
    "@types/plist": "3.0.5",
    "lerna": "10.1.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "phaser": "4.2.1",
    "phaser3": "npm:phaser@3.90.0",
    "pixi.js": "8.23.0",
    "plist": "5.1.1",
    "publint": "0.3.25",
    "sharp": "0.35.5",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "packageManager": "pnpm@10.34.7"
}
